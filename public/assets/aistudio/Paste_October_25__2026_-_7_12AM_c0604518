    <!-- CORE JAVASCRIPT APPLICATION LOGIC -->
    <script>
        // STRICT SEPARATION: Admin is totally separate from Members list
        const ADMIN_USER = { id: 'admin_sys', name: 'মেস এডমিন', username: 'admin', isAdmin: true };

        // INITIAL MEMBERS: Limon, Sujoy, Zisman
        const DEFAULT_MEMBERS = [
            { id: 'm1', name: 'Limon', phone: '01711112222', username: 'limon', isAdmin: false },
            { id: 'm2', name: 'Sujoy', phone: '01833334444', username: 'sujoy', isAdmin: false },
            { id: 'm3', name: 'Zisman', phone: '01955556666', username: 'zisman', isAdmin: false }
        ];

        const TODAY_STR = new Date().toISOString().split('T')[0];

        // GLOBAL APPLICATION STATE
        let state = {
            currentUser: null,
            members: JSON.parse(localStorage.getItem('bachelor_members_v2')) || DEFAULT_MEMBERS,
            // meals structure: { "YYYY-MM-DD": { "m1": { breakfast: 0.5, lunch: 1, dinner: 1, guest: 0 }, ... } }
            meals: JSON.parse(localStorage.getItem('bachelor_meals_v2')) || {
                [TODAY_STR]: {
                    'm1': { breakfast: 0.5, lunch: 1, dinner: 1, guest: 1 },
                    'm2': { breakfast: 0, lunch: 1, dinner: 1, guest: 0 },
                    'm3': { breakfast: 0.5, lunch: 0, dinner: 1, guest: 0 }
                }
            },
            // bazar structure: [ { id, date, shopperIds: ['m1', 'm2'], items, amount, status } ]
            bazar: JSON.parse(localStorage.getItem('bachelor_bazar_v2')) || [
                { id: 'b1', date: TODAY_STR, shopperIds: ['m1', 'm2'], items: 'চাল, সয়াবিন তেল, ডিম', amount: 1200, status: 'approved' }
            ],
            deposits: JSON.parse(localStorage.getItem('bachelor_deposits_v2')) || [
                { id: 'd1', date: TODAY_STR, memberId: 'm1', amount: 3000, note: 'বিকাশ', status: 'approved' },
                { id: 'd2', date: TODAY_STR, memberId: 'm2', amount: 2500, note: 'ক্যাশ', status: 'approved' },
                { id: 'd3', date: TODAY_STR, memberId: 'm3', amount: 2000, note: 'ক্যাশ', status: 'approved' }
            ],
            pendingRequests: JSON.parse(localStorage.getItem('bachelor_pending_v2')) || [],
            fines: JSON.parse(localStorage.getItem('bachelor_fines_v2')) || []
        };

        let chartInstance = null;

        // SAVE STATE TO STORAGE
        function saveData() {
            localStorage.setItem('bachelor_members_v2', JSON.stringify(state.members));
            localStorage.setItem('bachelor_meals_v2', JSON.stringify(state.meals));
            localStorage.setItem('bachelor_bazar_v2', JSON.stringify(state.bazar));
            localStorage.setItem('bachelor_deposits_v2', JSON.stringify(state.deposits));
            localStorage.setItem('bachelor_pending_v2', JSON.stringify(state.pendingRequests));
            localStorage.setItem('bachelor_fines_v2', JSON.stringify(state.fines));
            renderAll();
        }

        // INIT LOAD
        window.onload = function() {
            // Default active session: Limon
            state.currentUser = state.members[0];
            document.getElementById('mealDatePicker').value = TODAY_STR;
            calculateUtilities();
            renderAll();
        };

        // RENDER ALL COMPONENTS
        function renderAll() {
            updateHeaderUI();
            renderMealMatrix();
            renderMonthlyMealSummary();
            renderBazarTracker();
            renderDepositTable();
            renderMembersList();
            renderPendingRequests();
            renderFines();
            renderAnalyticsChart();
            updateCalculatedStats();
        }

        // HEADER & USER ACCOUNT SWITCHING
        function updateHeaderUI() {
            const userLabel = document.getElementById('headerUserLabel');
            if (state.currentUser) {
                userLabel.innerText = `${state.currentUser.name} (${state.currentUser.isAdmin ? 'Admin' : 'Member'})`;
            } else {
                userLabel.innerText = 'লগইন';
            }

            const adminAddBtn = document.getElementById('adminAddMemberBtn');
            if (state.currentUser && state.currentUser.isAdmin) {
                adminAddBtn.classList.remove('hidden');
            } else {
                adminAddBtn.classList.add('hidden');
            }

            // Badges
            const count = state.pendingRequests.length;
            const badge = document.getElementById('pendingBadge');
            const tabBadge = document.getElementById('tabBadge');
            const mobBadge = document.getElementById('mobPendingBadge');
            const queueCount = document.getElementById('pendingQueueCount');

            if (count > 0) {
                badge.innerText = count;
                badge.classList.remove('hidden');
                tabBadge.innerText = count;
                mobBadge.innerText = count;
                mobBadge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
                tabBadge.innerText = '0';
                mobBadge.classList.add('hidden');
            }
            if (queueCount) queueCount.innerText = `${count} টি পেন্ডিং`;
        }

        function openUserSwitchModal() {
            const select = document.getElementById('userSelectDropdown');
            select.innerHTML = `
                <option value="${ADMIN_USER.id}">👑 মেস এডমিন (Admin System)</option>
                ${state.members.map(m => `<option value="${m.id}">👤 ${m.name}</option>`).join('')}
            `;

            if (state.currentUser) {
                select.value = state.currentUser.id;
            }

            toggleAdminPassField();
            document.getElementById('userSwitchModal').classList.remove('hidden');
        }

        function toggleAdminPassField() {
            const val = document.getElementById('userSelectDropdown').value;
            const container = document.getElementById('adminPassContainer');
            if (val === ADMIN_USER.id) {
                container.classList.remove('hidden');
            } else {
                container.classList.add('hidden');
            }
        }

        function performLogin() {
            const selectId = document.getElementById('userSelectDropdown').value;

            if (selectId === ADMIN_USER.id) {
                const passInput = document.getElementById('adminPassInput').value;
                // SECURE CHECK: Secret Admin Pass is 1234
                if (passInput !== '1234') {
                    showToast('ভুল এডমিন পাসওয়ার্ড!', 'error');
                    return;
                }
                state.currentUser = ADMIN_USER;
            } else {
                const targetMem = state.members.find(m => m.id === selectId);
                if (targetMem) state.currentUser = targetMem;
            }

            showToast(`স্বাগতম, ${state.currentUser.name}!`);
            closeModal('userSwitchModal');
            document.getElementById('adminPassInput').value = '';
            renderAll();
        }

        // TAB SWITCHING LOGIC
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.nav-btn').forEach(el => {
                el.classList.remove('bg-brand-600', 'text-white', 'shadow');
                el.classList.add('text-slate-400');
            });

            const activeTab = document.getElementById(`tab-${tabId}`);
            if (activeTab) activeTab.classList.remove('hidden');

            const activeBtn = document.getElementById(`tab-btn-${tabId}`);
            if (activeBtn) {
                activeBtn.classList.add('bg-brand-600', 'text-white', 'shadow');
                activeBtn.classList.remove('text-slate-400');
            }


        // HANDLE MEAL SWITCH UPDATE
        function handleMealToggle(date, memberId, mealType, isChecked) {
            const member = state.members.find(m => m.id === memberId);

            if (state.currentUser.isAdmin) {
                if (!state.meals[date]) state.meals[date] = {};
                if (!state.meals[date][memberId]) state.meals[date][memberId] = { breakfast: 0, lunch: 0, dinner: 0, guest: 0 };

                let val = 0;
                if (isChecked) val = (mealType === 'breakfast') ? 0.5 : 1.0;
                state.meals[date][memberId][mealType] = val;
                saveData();
                showToast(`এডমিন আপডেট করেছেন: ${member.name}`);
            } else {
                const req = {
                    id: 'req_' + Date.now(),
                    type: 'MEAL_CHANGE',
                    requestedBy: state.currentUser.name,
                    date: date,
                    dataPayload: { memberId, mealType, isChecked, date },
                    details: `${date} তারিখে ${member.name}-এর ${mealType === 'breakfast' ? 'সকাল' : mealType === 'lunch' ? 'দুপুর' : 'রাত'} মিল ${isChecked ? 'অন' : 'অফ'} করার আবেদন`

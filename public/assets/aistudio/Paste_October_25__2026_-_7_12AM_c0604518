```html
<!DOCTYPE html>
<html lang="bn" class="h-full bg-slate-950 text-slate-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>ব্যাচেলর মেস ও মিল ম্যানেজার</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts (Hind Siliguri for Bangla) -->
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Chart.js for Graphical Analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Hind Siliguri', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Hind Siliguri', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }
        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .hide-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        /* Toggle Switch UI */
        .toggle-checkbox:checked {
            right: 0;
            border-color: #6366f1;
        }
        .toggle-checkbox:checked + .toggle-label {
            background-color: #4f46e5;
        }
    </style>
</head>
<body class="h-full flex flex-col justify-between overflow-x-hidden selection:bg-brand-500 selection:text-white pb-20 md:pb-0">

    <!-- Top Navigation Header -->
    <header class="bg-slate-900 border-b border-slate-800 sticky top-0 z-30 px-4 py-3 flex items-center justify-between shadow-md">
        <div class="flex items-center space-x-3 space-x-reverse">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-indigo-400 flex items-center justify-center text-white text-xl font-bold shadow-lg shadow-brand-500/20">
                <i class="fa-solid fa-utensils"></i>
            </div>
            <div>
                <h1 class="font-bold text-lg text-white leading-tight">মেস ম্যানেজার</h1>
                <p id="currentMonthYear" class="text-xs text-slate-400">স্মার্ট ব্যাচেলর মেস সমাধান</p>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <!-- Pending Requests Counter for Admin/User -->
            <button onclick="switchTab('pending-requests')" id="headerPendingBtn" class="relative p-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg transition border border-slate-700">
                <i class="fa-solid fa-bell text-amber-400"></i>
                <span id="pendingBadge" class="absolute -top-1 -right-1 bg-rose-500 text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center hidden">0</span>
            </button>
            
            <!-- User Login / Switch Button -->
            <button onclick="openUserSwitchModal()" class="flex items-center gap-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-200 transition">
                <div class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></div>
                <span id="headerUserLabel">লগইন</span>
                <i class="fa-solid fa-chevron-down text-slate-400 text-[10px]"></i>
            </button>
        </div>
    </header>

    <!-- Global Toast Alerts -->
    <div id="toastContainer" class="fixed top-16 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- Main Container -->
    <main class="flex-1 max-w-5xl w-full mx-auto px-4 py-4 space-y-5">
        
        <!-- Summary Dashboard Header -->
        <section id="dashboardSummary" class="grid grid-cols-2 md:grid-cols-4 gap-3">
            <div class="bg-slate-900/80 border border-slate-800 p-3.5 rounded-2xl shadow-sm">
                <div class="flex items-center justify-between text-slate-400 text-xs mb-1">
                    <span>মোট মিল</span>
                    <i class="fa-solid fa-bowl-rice text-brand-500"></i>
                </div>
                <div class="text-xl font-bold text-white" id="statTotalMeals">0</div>
                <div class="text-[11px] text-slate-400 mt-0.5">গেস্ট মিল সহ</div>
            </div>

            <div class="bg-slate-900/80 border border-slate-800 p-3.5 rounded-2xl shadow-sm">
                <div class="flex items-center justify-between text-slate-400 text-xs mb-1">
                    <span>মোট জমা</span>
                    <i class="fa-solid fa-wallet text-emerald-400"></i>
                </div>
                <div class="text-xl font-bold text-emerald-400" id="statTotalDeposit">৳ 0</div>
                <div class="text-[11px] text-slate-400 mt-0.5">সব মেম্বারের ক্যাশ জমা</div>
            </div>

            <div class="bg-slate-900/80 border border-slate-800 p-3.5 rounded-2xl shadow-sm">
                <div class="flex items-center justify-between text-slate-400 text-xs mb-1">
                    <span>বাজার খরচ</span>
                    <i class="fa-solid fa-cart-shopping text-amber-400"></i>
                </div>
                <div class="text-xl font-bold text-amber-400" id="statTotalBazar">৳ 0</div>
                <div class="text-[11px] text-slate-400 mt-0.5" id="statBazarBalance">অবশিষ্ট: ৳ 0</div>
            </div>

            <div class="bg-slate-900/80 border border-slate-800 p-3.5 rounded-2xl shadow-sm">
                <div class="flex items-center justify-between text-slate-400 text-xs mb-1">
                    <span>বর্তমান মিল রেট</span>
                    <i class="fa-solid fa-chart-line text-rose-400"></i>
                </div>
                <div class="text-xl font-bold text-rose-400" id="statMealRate">৳ 0.00</div>
                <div class="text-[11px] text-slate-400 mt-0.5">প্রতি মিলের আনুমানিক খরচ</div>
            </div>
        </section>

        <!-- Main Desktop Navigation Bar -->
        <nav class="flex overflow-x-auto hide-scrollbar gap-2 bg-slate-900/60 p-1.5 rounded-xl border border-slate-800/80 text-xs font-semibold">
            <button onclick="switchTab('meals')" id="tab-btn-meals" class="nav-btn px-4 py-2 rounded-lg transition shrink-0 bg-brand-600 text-white shadow">
                <i class="fa-solid fa-calendar-days mr-1.5"></i>দৈনিক মিল ও গেস্ট
            </button>
            <button onclick="switchTab('bazar')" id="tab-btn-bazar" class="nav-btn px-4 py-2 rounded-lg transition shrink-0 text-slate-400 hover:text-slate-200 hover:bg-slate-800">
                <i class="fa-solid fa-shopping-basket mr-1.5"></i>যৌথ বাজার খাতা
            </button>
            <button onclick="switchTab('analytics')" id="tab-btn-analytics" class="nav-btn px-4 py-2 rounded-lg transition shrink-0 text-slate-400 hover:text-slate-200 hover:bg-slate-800">
                <i class="fa-solid fa-chart-pie mr-1.5"></i>গ্রাফিক্যাল অ্যানালিটিক্স
            </button>
            <button onclick="switchTab('deposits')" id="tab-btn-deposits" class="nav-btn px-4 py-2 rounded-lg transition shrink-0 text-slate-400 hover:text-slate-200 hover:bg-slate-800">
                <i class="fa-solid fa-money-bill-wave mr-1.5"></i>জমা ও ব্যালেন্স
            </button>
            <button onclick="switchTab('pending-requests')" id="tab-btn-pending-requests" class="nav-btn px-4 py-2 rounded-lg transition shrink-0 text-slate-400 hover:text-slate-200 hover:bg-slate-800 relative">
                <i class="fa-solid fa-clock-rotate-left mr-1.5"></i>পেন্ডিং রিকোয়েস্ট
                <span id="tabBadge" class="ml-1 bg-amber-500 text-slate-950 font-bold px-1.5 py-0.5 rounded-full text-[10px]">0</span>
            </button>
            <button onclick="switchTab('members')" id="tab-btn-members" class="nav-btn px-4 py-2 rounded-lg transition shrink-0 text-slate-400 hover:text-slate-200 hover:bg-slate-800">
                <i class="fa-solid fa-users mr-1.5"></i>মেম্বার
            </button>
            <button onclick="switchTab('utilities')" id="tab-btn-utilities" class="nav-btn px-4 py-2 rounded-lg transition shrink-0 text-slate-400 hover:text-slate-200 hover:bg-slate-800">
                <i class="fa-solid fa-receipt mr-1.5"></i>ইউটিলিটি ও রাঁধুনী
            </button>
        </nav>

        <!-- TAB CONTENT 1: MEALS SWITCH & GUEST MEAL PER MEMBER -->
        <section id="tab-meals" class="tab-content space-y-4">
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-sm">
                <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-3 mb-4">
                    <div>
                        <h2 class="text-base font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-utensils text-brand-500"></i>দৈনিক ৩ বেলা মিল ও গেস্ট সুইচার
                        </h2>
                        <p class="text-xs text-slate-400">প্রতিটি মেম্বারের অন/অফ সুইচ এবং নিজস্ব গেস্ট মিল যুক্ত করুন</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <label class="text-xs text-slate-400">তারিখ:</label>
                        <input type="date" id="mealDatePicker" onchange="renderMealMatrix()" class="bg-slate-800 border border-slate-700 text-white rounded-lg px-2.5 py-1.5 text-xs focus:ring-2 focus:ring-brand-500 outline-none">
                    </div>
                </div>

                <!-- 3 Meal + Guest Input Cards / List -->
                <div id="mealCardsContainer" class="space-y-3">
                    <!-- Dynamic Member Meal Switch Rows -->
                </div>
            </div>

            <!-- Total Month Meal Summary Table -->
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-sm">
                <h3 class="text-sm font-bold text-white mb-3 flex items-center gap-2">
                    <i class="fa-solid fa-list-check text-emerald-400"></i>মেম্বারভিত্তিক মোট মিলের অবস্থা
                </h3>
                <div id="monthlyMealSummary" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <!-- Dynamic Summary Cards -->
                </div>
            </div>
        </section>

        <!-- TAB CONTENT 2: MULTI-MEMBER JOINT BAZAR TRACKER -->
        <section id="tab-bazar" class="tab-content space-y-4 hidden">
            <div class="flex justify-between items-center bg-slate-900 border border-slate-800 p-4 rounded-2xl">
                <div>
                    <h2 class="text-base font-bold text-white">যৌথ বাজার খাতা ও বাজার কাউন্টার</h2>
                    <p class="text-xs text-slate-400">একসাথে একাধিক মেম্বারের বাজারে যাওয়া এবং কার কয়টি বাজার সম্পন্ন হয়েছে</p>
                </div>
                <button onclick="openAddBazarModal()" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-xl transition shadow flex items-center gap-1.5">
                    <i class="fa-solid fa-plus"></i> যৌথ বাজার যুক্ত করুন
                </button>
            </div>

            <!-- Shopping Count Tracker Cards -->
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3">
                <h3 class="text-xs font-bold text-slate-300 uppercase tracking-wider">মেম্বারদের বাজার দেওয়ার সংখ্যা (Trip Counter)</h3>
                <div id="bazarTripsContainer" class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                    <!-- Dynamic Trip Count Cards -->
                </div>
            </div>

            <!-- Bazar History Table -->
            <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-sm">
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs text-slate-300">
                        <thead class="bg-slate-800/80 text-slate-300 border-b border-slate-700 font-semibold">
                            <tr>
                                <th class="p-3">তারিখ</th>
                                <th class="p-3">বাজারকারী (মেম্বারবৃন্দ)</th>
                                <th class="p-3">আইটেম সমুহ</th>
                                <th class="p-3 text-right">মোট টাকা (৳)</th>
                                <th class="p-3 text-center">স্ট্যাটাস</th>
                            </tr>
                        </thead>
                        <tbody id="bazarTableBody" class="divide-y divide-slate-800 bg-slate-900">
                            <!-- Dynamic Content -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- TAB CONTENT 3: GRAPHICAL ANALYTICS & FINANCIAL BALANCE HEALTH -->
        <section id="tab-analytics" class="tab-content space-y-4 hidden">
            <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl">
                <h2 class="text-base font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-chart-column text-brand-400"></i>মেসের গ্রাফিক্যাল অ্যানালিটিক্স
                </h2>
                <p class="text-xs text-slate-400">মেম্বারদের দেওয়া টাকা বনাম মিল খরচের দৃশ্যমান তুলনামূলক চিত্র</p>
            </div>

            <!-- Chart.js Graph View -->
            <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl shadow-sm">
                <div class="h-64 sm:h-80 relative">
                    <canvas id="balanceChart"></canvas>
                </div>
            </div>

            <!-- Detailed Balance Health Recommendations (কমে দিল / বেশি দিল) -->
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-heart-pulse text-rose-400"></i>মেম্বারদের টাকা জমা দেওয়ার স্বাস্থ্যগত অবস্থা (Health Status)
                </h3>
                <div id="financialHealthList" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <!-- Dynamic Health Cards -->
                </div>
            </div>
        </section>

        <!-- TAB CONTENT 4: DEPOSITS & CASH OVERVIEW -->
        <section id="tab-deposits" class="tab-content space-y-4 hidden">
            <div class="flex justify-between items-center bg-slate-900 border border-slate-800 p-4 rounded-2xl">
                <div>
                    <h2 class="text-base font-bold text-white">মেস ডিপোজিট খাতা</h2>
                    <p class="text-xs text-slate-400">মেম্বারদের টাকা জমার হিসাব</p>
                </div>
                <button onclick="openAddDepositModal()" class="px-3.5 py-2 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-xl transition shadow flex items-center gap-1.5">
                    <i class="fa-solid fa-wallet"></i> টাকা জমা এন্ট্রি
                </button>
            </div>

            <div id="memberBalanceCards" class="grid grid-cols-1 md:grid-cols-3 gap-3">
                <!-- Dynamic Content -->
            </div>

            <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-sm">
                <div class="p-3 border-b border-slate-800 font-semibold text-xs text-slate-200">
                    জমা দেওয়ার সাম্প্রতিক ইতিহাস
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs text-slate-300">
                        <thead class="bg-slate-800/80 text-slate-400">
                            <tr>
                                <th class="p-3">তারিখ</th>
                                <th class="p-3">মেম্বার</th>
                                <th class="p-3">মেথড / নোট</th>
                                <th class="p-3 text-right">পরিমাণ (৳)</th>
                                <th class="p-3 text-center">অবস্থা</th>
                            </tr>
                        </thead>
                        <tbody id="depositTableBody" class="divide-y divide-slate-800">
                            <!-- Dynamic Content -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- TAB CONTENT 5: PENDING REQUESTS (ADMIN APPROVAL QUEUE) -->
        <section id="tab-pending-requests" class="tab-content space-y-4 hidden">
            <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-base font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-shield-halved text-amber-400"></i>অ্যাডমিন অ্যাপ্রুভাল প্যানেল
                        </h2>
                        <p class="text-xs text-slate-400">মেম্বারদের পাঠানো অন/অফ, বাজার, ও প্রোফাইল পরিবর্তন রিকোয়েস্ট</p>
                    </div>
                    <span id="pendingQueueCount" class="bg-amber-500/20 text-amber-300 text-xs px-2.5 py-1 rounded-full font-bold border border-amber-500/30">
                        ০ টি পেন্ডিং
                    </span>
                </div>
            </div>

            <div id="pendingRequestsList" class="space-y-3">
                <!-- Dynamic Pending Request Items -->
            </div>
        </section>

        <!-- TAB CONTENT 6: MEMBERS DIRECTORY -->
        <section id="tab-members" class="tab-content space-y-4 hidden">
            <div class="flex justify-between items-center bg-slate-900 border border-slate-800 p-4 rounded-2xl">
                <div>
                    <h2 class="text-base font-bold text-white">মেম্বারদের তালিকা</h2>
                    <p class="text-xs text-slate-400">মেসের সব সক্রিয় সদস্য</p>
                </div>
                <button id="adminAddMemberBtn" onclick="openAddMemberModal()" class="hidden px-3.5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-xl transition shadow flex items-center gap-1.5">
                    <i class="fa-solid fa-user-plus"></i> নতুন মেম্বার যোগ করুন
                </button>
            </div>

            <div id="membersListGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                <!-- Dynamic Member Cards -->
            </div>
        </section>

        <!-- TAB CONTENT 7: UTILITIES, PENALTIES & DUTY SPINNER -->
        <section id="tab-utilities" class="tab-content space-y-4 hidden">
            <!-- Cooking Duty Spinner Wheel -->
            <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl text-center space-y-3">
                <h2 class="text-base font-bold text-white flex items-center justify-center gap-2">
                    <i class="fa-solid fa-kitchen-set text-amber-400"></i>আজকের রাঁধুনী ও বাজার নির্বাচন (Duty Selector)
                </h2>
                <p class="text-xs text-slate-400">আজকে কে রান্না বা বাজার করবে তা সহজে লটারি করুন</p>
                <div class="py-2">
                    <div id="spinnedResult" class="text-lg font-bold text-brand-300 bg-brand-500/10 p-3 rounded-xl border border-brand-500/20 max-w-xs mx-auto">
                        বাটন চাপুন
                    </div>
                </div>
                <button onclick="spinDuty()" class="px-5 py-2 bg-gradient-to-r from-brand-600 to-indigo-600 hover:from-brand-700 hover:to-indigo-700 text-white font-bold text-xs rounded-xl shadow-md transition">
                    <i class="fa-solid fa-dice mr-1"></i> রাঁধুনী বেছে নিন
                </button>
            </div>

            <!-- Fine & Penalty Section -->
            <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl space-y-3">
                <div class="flex justify-between items-center">
                    <div>
                        <h2 class="text-base font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-gavel text-rose-400"></i>জরিমানা খাতা (Fine Ledger)
                        </h2>
                        <p class="text-xs text-slate-400">নিয়ম ভঙ্গের জরিমানা ধারা ও হিসাব</p>
                    </div>
                    <button onclick="openFineModal()" class="px-3 py-1.5 bg-rose-600 hover:bg-rose-700 text-white text-xs rounded-lg font-semibold transition">
                        + জরিমানা যুক্ত করুন
                    </button>
                </div>

                <div class="overflow-x-auto rounded-xl border border-slate-800">
                    <table class="w-full text-left text-xs text-slate-300">
                        <thead class="bg-slate-800 text-slate-400">
                            <tr>
                                <th class="p-2.5">তারিখ</th>
                                <th class="p-2.5">মেম্বার</th>
                                <th class="p-2.5">কারণ</th>
                                <th class="p-2.5 text-right">জরিমানা (৳)</th>

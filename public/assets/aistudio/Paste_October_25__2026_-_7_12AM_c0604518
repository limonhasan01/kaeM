                };
                state.pendingRequests.push(req);
                showToast('জমার আবেদন এডমিনের কাছে জমা হয়েছে');
            }

            saveData();
            closeModal('addDepositModal');
        }

        // MEMBERS LIST & MANAGEMENT
        function renderMembersList() {
            const grid = document.getElementById('membersListGrid');
            grid.innerHTML = state.members.map(m => {
                const isSelf = state.currentUser && state.currentUser.id === m.id;
                const isAdmin = state.currentUser && state.currentUser.isAdmin;

                return `
                    <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl shadow-sm space-y-3">
                        <div class="flex items-center gap-3">
                            <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-brand-600 to-indigo-500 flex items-center justify-center font-bold text-white text-lg shadow-md">
                                ${m.name.charAt(0)}
                            </div>
                            <div>
                                <h3 class="font-bold text-white text-sm">${m.name}</h3>
                                <p class="text-xs text-slate-400">ইউজারনেম: @${m.username}</p>
                            </div>
                        </div>

                        <div class="space-y-1 text-xs text-slate-300 pt-2 border-t border-slate-800">
                            <div class="flex items-center gap-2">
                                <i class="fa-solid fa-phone text-slate-500 w-4"></i>
                                <span>${m.phone}</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <i class="fa-solid fa-lock text-slate-500 w-4"></i>
                                <span class="text-slate-500 font-mono">••••••••</span>
                            </div>
                        </div>

                        <div class="pt-2 flex items-center justify-between gap-2 border-t border-slate-800/60">
                            ${(isSelf || isAdmin) ? `
                                <button onclick="openProfileEditModal('${m.id}')" class="w-full py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-medium rounded-xl transition border border-slate-700 flex items-center justify-center gap-1.5">
                                    <i class="fa-solid fa-pen-to-square"></i> প্রোফাইল এডিট
                                </button>
                            ` : `<span class="text-[11px] text-slate-600 italic">নিজের তথ্য এডিট করা যাবে</span>`}

                            ${(isAdmin) ? `
                                <button onclick="handleDeleteMember('${m.id}')" class="px-2.5 py-1.5 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 text-xs rounded-xl border border-rose-500/20 transition" title="মেম্বার ডিলিট">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            ` : ''}
                        </div>
                    </div>
                `;
            }).join('');
        }

        function openProfileEditModal(memberId) {
            const mem = state.members.find(m => m.id === memberId);
            if (!mem) return;

            document.getElementById('editProfileMemberId').value = mem.id;
            document.getElementById('editProfileName').value = mem.name;
            document.getElementById('editProfilePhone').value = mem.phone;
            document.getElementById('editProfileUsername').value = mem.username;

            document.getElementById('profileEditModal').classList.remove('hidden');
        }

        function submitProfileEditRequest(e) {
            e.preventDefault();
            const memberId = document.getElementById('editProfileMemberId').value;
            const newName = document.getElementById('editProfileName').value;
            const newPhone = document.getElementById('editProfilePhone').value;
            const newUsername = document.getElementById('editProfileUsername').value;

            const mem = state.members.find(m => m.id === memberId);

            if (state.currentUser.isAdmin) {
                mem.name = newName;
                mem.phone = newPhone;
                mem.username = newUsername;
                saveData();
                showToast('প্রোফাইল তথ্য আপডেট হয়েছে');
            } else {
                const req = {
                    id: 'req_' + Date.now(),
                    type: 'PROFILE_EDIT',
                    requestedBy: state.currentUser.name,
                    date: TODAY_STR,
                    dataPayload: { memberId, newName, newPhone, newUsername },
                    details: `${mem.name}-এর নাম (${newName}), ফোন (${newPhone}) হালনাগাদ আবেদন`
                };
                state.pendingRequests.push(req);
                saveData();
                showToast('প্রোফাইল পরিবর্তনের অনুরোধ এডমিনের কাছে পাঠানো হয়েছে');
            }

            closeModal('profileEditModal');
        }

        function openAddMemberModal() {
            document.getElementById('addMemberModal').classList.remove('hidden');
        }

        function handleAddMemberSubmit(e) {
            e.preventDefault();
            if (!state.currentUser.isAdmin) {
                showToast('শুধুমাত্র এডমিন মেম্বার যুক্ত করতে পারবেন', 'error');
                return;
            }

            const name = document.getElementById('newMemName').value;
            const username = document.getElementById('newMemUsername').value;
            const phone = document.getElementById('newMemPhone').value;

            const newMem = {
                id: 'm_' + Date.now(),
                name,
                username,
                phone,
                isAdmin: false
            };

            state.members.push(newMem);
            saveData();
            showToast('নতুন মেম্বার তৈরি হয়েছে');
            closeModal('addMemberModal');
        }

        function handleDeleteMember(memberId) {
            if (!state.currentUser.isAdmin) return;
            if (confirm('আপনি কি নিশ্চিত যে এই মেম্বারকে ডিলিট করবেন?')) {
                state.members = state.members.filter(m => m.id !== memberId);
                saveData();
                showToast('মেম্বার ডিলিট করা হয়েছে');
            }
        }

        // PENDING REQUEST QUEUE & APPROVAL SYSTEM
        function renderPendingRequests() {
            const container = document.getElementById('pendingRequestsList');

            if (state.pendingRequests.length === 0) {
                container.innerHTML = `
                    <div class="bg-slate-900 border border-slate-800 p-8 text-center rounded-2xl text-slate-500 text-xs">
                        <i class="fa-solid fa-circle-check text-3xl mb-2 text-emerald-500/40"></i>
                        <p>কোনো পেন্ডিং রিকোয়েস্ট নেই!</p>
                    </div>
                `;
                return;
            }

            const isAdmin = state.currentUser && state.currentUser.isAdmin;

            container.innerHTML = state.pendingRequests.map(r => `
                <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-sm">
                    <div class="space-y-1">
                        <div class="flex items-center gap-2">
                            <span class="px-2 py-0.5 rounded-full text-[10px] bg-brand-500/20 text-brand-300 font-semibold border border-brand-500/30">
                                ${r.type}
                            </span>
                            <span class="text-xs text-slate-400 font-mono">${r.date}</span>
                            <span class="text-xs text-slate-300 font-semibold">• ${r.requestedBy}</span>
                        </div>
                        <p class="text-xs text-white font-medium">${r.details}</p>
                    </div>

                    ${isAdmin ? `
                        <div class="flex items-center gap-2 shrink-0">
                            <button onclick="approveRequest('${r.id}')" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-xl transition shadow">
                                <i class="fa-solid fa-check mr-1"></i> অ্যাপ্রুভ
                            </button>
                            <button onclick="rejectRequest('${r.id}')" class="px-3 py-1.5 bg-rose-600/20 hover:bg-rose-600/30 text-rose-400 border border-rose-500/30 text-xs font-semibold rounded-xl transition">
                                <i class="fa-solid fa-xmark mr-1"></i> বাতিল
                            </button>
                        </div>
                    ` : `
                        <div class="text-xs text-amber-400/80 bg-amber-500/10 px-2.5 py-1 rounded-lg border border-amber-500/20 text-center">
                            এডমিন অ্যাপ্রুভালের অপেক্ষায়
                        </div>
                    `}
                </div>
            `).join('');
        }

        function approveRequest(reqId) {
            if (!state.currentUser.isAdmin) return;

            const reqIndex = state.pendingRequests.findIndex(r => r.id === reqId);
            if (reqIndex === -1) return;

            const req = state.pendingRequests[reqIndex];
            const payload = req.dataPayload;

            if (req.type === 'MEAL_CHANGE') {
                const { memberId, mealType, isChecked, date } = payload;
                if (!state.meals[date]) state.meals[date] = {};
                if (!state.meals[date][memberId]) state.meals[date][memberId] = { breakfast: 0, lunch: 0, dinner: 0, guest: 0 };

                let val = 0;
                if (isChecked) val = (mealType === 'breakfast') ? 0.5 : 1.0;
                state.meals[date][memberId][mealType] = val;
            }
            else if (req.type === 'GUEST_MEAL') {
                const { memberId, date, count } = payload;
                if (!state.meals[date]) state.meals[date] = {};
                if (!state.meals[date][memberId]) state.meals[date][memberId] = { breakfast: 0, lunch: 0, dinner: 0, guest: 0 };
                state.meals[date][memberId].guest = count;
            }
            else if (req.type === 'BAZAR_ENTRY') {
                state.bazar.push({
                    id: 'b_' + Date.now(),
                    date: payload.date,
                    shopperIds: payload.shopperIds,
                    items: payload.items,
                    amount: payload.amount,
                    status: 'approved'
                });
            }
            else if (req.type === 'DEPOSIT_ENTRY') {
                state.deposits.push({
                    id: 'd_' + Date.now(),
                    date: payload.date,
                    memberId: payload.memberId,
                    amount: payload.amount,
                    note: payload.note,
                    status: 'approved'
                });
            }
            else if (req.type === 'PROFILE_EDIT') {
                const mem = state.members.find(m => m.id === payload.memberId);
                if (mem) {
                    mem.name = payload.newName;
                    mem.phone = payload.newPhone;
                    mem.username = payload.newUsername;
                }
            }

            state.pendingRequests.splice(reqIndex, 1);
            saveData();
            showToast('রিকোয়েস্ট অ্যাপ্রুভ হয়েছে');
        }

        function rejectRequest(reqId) {
            if (!state.currentUser.isAdmin) return;
            state.pendingRequests = state.pendingRequests.filter(r => r.id !== reqId);
            saveData();
            showToast('রিকোয়েস্ট বাতিল করা হয়েছে', 'error');
        }

        // DUTY SPINNER & FINES
        function spinDuty() {
            if (state.members.length === 0) return;
            const randIndex = Math.floor(Math.random() * state.members.length);
            const selected = state.members[randIndex];
            document.getElementById('spinnedResult').innerText = `🎉 আজকে নির্বাচিত: ${selected.name}`;
        }

        function renderFines() {
            const tbody = document.getElementById('fineTableBody');
            tbody.innerHTML = state.fines.map(f => {
                const mem = state.members.find(m => m.id === f.memberId);
                return `
                    <tr class="hover:bg-slate-800/40">
                        <td class="p-2.5 text-slate-400 font-mono">${f.date}</td>
                        <td class="p-2.5 font-medium text-white">${mem ? mem.name : 'অজানা'}</td>
                        <td class="p-2.5 text-slate-300">${f.reason}</td>
                        <td class="p-2.5 text-right font-bold text-rose-400">৳ ${f.amount}</td>
                    </tr>
                `;
            }).join('');
        }

        function openFineModal() {
            if (!state.currentUser.isAdmin) {
                showToast('শুধুমাত্র এডমিন জরিমানা ধার্য করতে পারবেন', 'error');
                return;
            }
            const select = document.getElementById('fineMemberSelect');
            select.innerHTML = state.members.map(m => `<option value="${m.id}">${m.name}</option>`).join('');
            document.getElementById('fineModal').classList.remove('hidden');
        }

        function submitFineEntry(e) {
            e.preventDefault();
            const memberId = document.getElementById('fineMemberSelect').value;
            const reason = document.getElementById('fineReason').value;
            const amount = Number(document.getElementById('fineAmount').value);

            state.fines.push({
                id: 'f_' + Date.now(),
                date: TODAY_STR,
                memberId,
                reason,
                amount
            });

            saveData();
            closeModal('fineModal');
            showToast('জরিমানা ধার্য করা হয়েছে');
        }

        // UTILITIES
        function calculateUtilities() {
            const rent = Number(document.getElementById('utilRent').value) || 0;
            const electric = Number(document.getElementById('utilElectric').value) || 0;
            const gas = Number(document.getElementById('utilGas').value) || 0;
            const other = Number(document.getElementById('utilOther').value) || 0;

            const total = rent + electric + gas + other;
            const perMember = state.members.length > 0 ? (total / state.members.length) : 0;

            document.getElementById('utilPerMember').innerText = `৳ ${perMember.toFixed(2)}`;
        }

        // HELPERS
        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            
            const bgColor = type === 'error' ? 'bg-rose-600' : 'bg-emerald-600';
            const icon = type === 'error' ? 'fa-circle-xmark' : 'fa-circle-check';

            toast.className = `${bgColor} text-white px-4 py-2.5 rounded-xl shadow-lg text-xs font-semibold flex items-center gap-2 transform transition duration-300 ease-out pointer-events-auto opacity-0 translate-y-2`;
            toast.innerHTML = `<i class="fa-solid ${icon}"></i> <span>${message}</span>`;

            container.appendChild(toast);

            setTimeout(() => toast.classList.remove('opacity-0', 'translate-y-2'), 10);
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }
    </script>
</body>
</html>
